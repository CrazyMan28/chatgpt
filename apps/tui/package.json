{
  "name": "@chatgpt-code/tui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "watch:dev": "concurrently \"tsx watch src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "postinstall": "npm run build && echo 'Project built. Use `npm start` to launch the TUI.'",
    "scan": "npm audit --production && npx synp --json > security-report.json"
  },
  "dependencies": {
    "@chatgpt-code/runtime-core": "0.2.0",
    "@chatgpt-code/storage-sqlite": "0.2.0",
    "@chatgpt-code/worker-remote": "0.2.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.15.0",
    "express": "^5.2.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "synp": "^3.0.0"
  }
}